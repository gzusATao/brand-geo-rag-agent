# 独立毕设库，不使用公司主库或国家库；.env由配置脚本写入并自动读取。
GEO_DB_ENGINE=mysql
GEO_MYSQL_HOST=127.0.0.1
GEO_MYSQL_PORT=3306
GEO_MYSQL_USER=
GEO_MYSQL_PASSWORD=
GEO_MYSQL_DATABASE=brand_geo_rag_agent
# SQLite仅作为自动化测试或离线演示的替代后端，不自动迁移旧样本到MySQL。
GEO_DATABASE_PATH=data/geo.db
# 本地 HTTP 为0；在 HTTPS 反向代理部署时设置1。
GEO_SESSION_SECURE=0
# 可选：仅供程序化访问的独立API令牌，不能代替网页账号登录。
GEO_API_TOKEN=
# 首页多智能体对话；推荐用 python -m scripts.configure_llm 在本地隐藏输入密钥。
# 密钥与接口须属于同一百炼地域；配置后重启服务，发送消息才会调用模型。
GEO_QWEN_API_KEY=
GEO_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GEO_QWEN_MODEL=qwen-plus
